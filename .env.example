# Plantilla de variables de entorno.
# Copiá este archivo como ".env" y completá tus propios valores.
# El archivo .env NO se sube a Git (ver .gitignore).

APP_NAME="RIFT OVERDRIVE"
APP_EMAIL=riftoverdrive@example.com
APP_ENV=local

# Base de datos MySQL. Completá usuario y contraseña con los de TU MySQL.
# (XAMPP: root y sin contraseña. MySQL instalado aparte: root y la contraseña que elegiste al instalar.)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rift_overdrive_db
DB_USER=root
DB_PASS=